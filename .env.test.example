# Banco de DADOS DE TESTE (marco B, secao 11 e 20).
#
# Este arquivo e OBRIGATORIO. Sem ele, os testes de integracao caem no
# `POSTGRES_DB` do `.env`, que e o banco das demonstracoes locais, e apagam o
# conteudo. O script `apps/api/test/support/carregar-env.ts` recusa com erro
# claro quando este arquivo falta ou aponta para o banco errado, e o
# provisionamento `infra/docker/postgres/provisionar.mjs` faz a mesma checagem
# antes de criar qualquer coisa.
#
# Copie de `.env.test.example` para `.env.test` e ajuste as senhas. Este
# arquivo entra no `.gitignore`: sao credenciais, ainda que de ambiente local.

# --- Identificacao do banco de teste -----------------------------------
# `POSTGRES_DB` precisa ser o MESMO valor de `TEST_POSTGRES_DB`. E assim que o
# guarda sabe que este `.env` e de teste e nao de trabalho.
POSTGRES_DB=sertania_test
TEST_POSTGRES_DB=sertania_test

# --- Credenciais --------------------------------------------------------
# O papel de migracao e dono do banco e roda as migrations. Nao e superusuario.
TEST_POSTGRES_MIGRATOR_USER=sertania_test_migrator
TEST_POSTGRES_MIGRATOR_PASSWORD=teste-migrador-local-apenas

# O papel da aplicacao e o que os testes usam para ler e escrever. Sem
# superusuario, sem `CREATE DB`, sem `CREATE ROLE`, sem `REPLICATION` e sem
# `BYPASSRLS`.
TEST_POSTGRES_USER=sertania_test_app
TEST_POSTGRES_PASSWORD=teste-app-local-apenas
