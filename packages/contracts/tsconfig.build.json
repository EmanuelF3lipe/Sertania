{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    // O pacote e consumido por NestJS, que e CommonJS. O `verbatimModuleSyntax`
    // da base exigiria sintaxe ESM e conflitaria com a emissao do framework.
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test", "dist", "node_modules"]
}
