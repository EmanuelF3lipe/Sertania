# Porta da API
PORTA=3000
# Pasta de dados (banco SQLite, anexos e backups)
PASTA_DADOS=./dados
# IA: "local" (heuristica, nenhum dado sai do servidor) ou "claude" (Claude API)
IA_PROVEDOR=local
# Necessaria apenas com IA_PROVEDOR=claude. Consumo de tokens e limite mensal: Configuracoes > Consumo da IA
ANTHROPIC_API_KEY=
# Dias apos a conclusao para anonimizar dados pessoais do solicitante (LGPD)
RETENCAO_DIAS=365
# Limiar minimo de casos para exibir um agrupamento em dados abertos
LIMIAR_SUPRESSAO=5

# Conteudo criado quando o banco nao existe: demonstracao | modelo | limpo
MODO_INICIAL=demonstracao

# Servidor de mapas (modelo Leaflet). Para uso intenso em producao, prefira um provedor proprio ou contratado.
# MAPA_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAPA_ATRIBUICAO=© colaboradores do OpenStreetMap
