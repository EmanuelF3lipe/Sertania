# Porta da API
PORTA=3000
# Pasta de dados (banco SQLite, anexos e backups)
PASTA_DADOS=./dados
# IA: "local" (heuristica, nenhum dado sai do servidor) ou "claude" (Claude API)
IA_PROVEDOR=local
# Necessaria apenas com IA_PROVEDOR=claude. Consumo de tokens e limite mensal: Configuracoes > Consumo da IA
ANTHROPIC_API_KEY=
# Dias apos a conclusao para anonimizar dados pessoais do solicitante (LGPD)
RETENCAO_DIAS=365
# Limiar minimo de casos para exibir um agrupamento em dados abertos
LIMIAR_SUPRESSAO=5

# Conteudo criado quando o banco nao existe: demonstracao | modelo | limpo
MODO_INICIAL=demonstracao

# Servidor de mapas (modelo Leaflet). Para uso intenso em producao, prefira um provedor proprio ou contratado.
# MAPA_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAPA_ATRIBUICAO=© colaboradores do OpenStreetMap

# ------------------------------------------------------------------ avisos ao cidadao e relatorio mensal
# Endereco publico do sistema (vai nos links de acompanhamento, avaliacao e painel)
URL_PUBLICA=https://servicos.sertania.pe.gov.br
# Canais: cada um pode ficar "desligado" (so registra), usar o provedor proprio ou o webhook da Prefeitura.
# Para o telefone, o WhatsApp e tentado primeiro e o SMS entra se ele falhar.
AVISOS_WHATSAPP=desligado   # meta | webhook | desligado
AVISOS_SMS=desligado        # twilio | webhook | desligado
AVISOS_EMAIL=desligado      # smtp | webhook | desligado

# WhatsApp oficial (Meta, WhatsApp Cloud API). Fora da janela de 24 h, so modelos aprovados pela Meta.
# Modelo de situacao: 3 variaveis -> {{1}} protocolo, {{2}} situacao, {{3}} link de acompanhamento
# Modelo de pesquisa: 3 variaveis -> {{1}} protocolo, {{2}} servico, {{3}} link de avaliacao
# WHATSAPP_TOKEN=
# WHATSAPP_NUMERO_ID=
# WHATSAPP_MODELO_SITUACAO=situacao_solicitacao
# WHATSAPP_MODELO_PESQUISA=pesquisa_satisfacao
# WHATSAPP_IDIOMA=pt_BR
# WHATSAPP_API_VERSAO=v23.0

# SMS (Twilio)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_NUMERO=+15550001111

# E-mail (SMTP da Prefeitura ou servico como SES, SendGrid, Brevo)
# SMTP_HOST=smtp.sertania.pe.gov.br
# SMTP_PORTA=587
# SMTP_SEGURO=nao           # "sim" para a porta 465 (TLS direto)
# SMTP_USUARIO=
# SMTP_SENHA=
# SMTP_REMETENTE=Prefeitura de Sertania <naoresponda@sertania.pe.gov.br>

# Webhook: o sistema faz POST JSON {via, para, assunto, texto, html, modelo, mensagemId} neste endereco,
# assinado no cabecalho X-Sertania-Assinatura (sha256=HMAC do corpo com o segredo). Serve para Zenvia, n8n etc.
# AVISOS_WEBHOOK_URL=
# AVISOS_WEBHOOK_SEGREDO=
