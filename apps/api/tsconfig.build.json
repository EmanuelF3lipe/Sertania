{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `rootDir` fica so no build: o typecheck inclui os testes, que ficam
    // fora de `src` e, com `rootDir` aqui, o compilador recusaria.
    "rootDir": "./src",
    "noEmit": false
  },
  // `scripts/` entra no typecheck e no lint, mas nao no build: os scripts sao
  // executados por `tsx` e nao precisam sair em `dist`. Sem este `exclude`, o
  // `rootDir: ./src` abaixo brigaria com eles, porque eles estao fora de `src`.
  "exclude": ["node_modules", "test", "scripts", "dist", "**/*.spec.ts"]
}
