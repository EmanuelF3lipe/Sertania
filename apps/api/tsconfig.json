{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023"],
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    "noEmit": true,
    // NestJS usa emissao de metadados de decorator e CommonJS. O
    // `verbatimModuleSyntax` da base exigiria sintaxe de importacao de tipo
    // explicita, que conflita com o modo de emissao do framework.
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
