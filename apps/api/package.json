{
    "name":  "@sertania/api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "commonjs",
    "main":  "dist/main.js",
    "scripts":  {
                    "dev":  "tsx watch src/main.ts",
                    "build":  "tsc -p tsconfig.build.json",
                    "start":  "node dist/main.js",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "lint":  "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
                    "format":  "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
                    "test":  "jest",
                    "test:unit":  "jest",
                    "test:integration":  "jest --config ./test/jest-integration.config.js --runInBand",
                    "db:migrate":  "typeorm-ts-node-commonjs migration:run -d ./src/database/data-source.ts",
                    "db:revert":  "typeorm-ts-node-commonjs migration:revert -d ./src/database/data-source.ts",
                    "db:seed":  "ts-node -r tsconfig-paths/register ./src/database/seeds/seed-dev.ts",
                    "openapi":  "ts-node -r tsconfig-paths/register ./src/openapi/generate.ts",
                    "db:test:migrate":  "tsx scripts/preparar-banco-de-teste.ts",
                    "db:test:verify":  "node ../../infra/docker/postgres/provisionar.mjs --verificar",
                    "db:test:provision":  "node ../../infra/docker/postgres/provisionar.mjs"
                },
    "dependencies":  {
                         "@nestjs/common":  "11.1.6",
                         "@nestjs/config":  "4.0.2",
                         "@nestjs/core":  "11.1.6",
                         "@nestjs/platform-express":  "11.1.6",
                         "@nestjs/swagger":  "11.2.0",
                         "@nestjs/terminus":  "11.0.0",
                         "@nestjs/typeorm":  "11.0.0",
                         "@sertania/contracts":  "workspace:*",
                         "ajv":  "8.17.1",
                         "ajv-formats":  "3.0.1",
                         "argon2":  "0.44.0",
                         "class-transformer":  "0.5.1",
                         "class-validator":  "0.14.2",
                         "cookie-parser":  "1.4.7",
                         "helmet":  "8.1.0",
                         "ioredis":  "5.8.1",
                         "nestjs-pino":  "4.4.0",
                         "nodemailer":  "7.0.6",
                         "openid-client":  "6.7.0",
                         "pino":  "9.13.1",
                         "pino-http":  "10.5.0",
                         "pg":  "8.16.3",
                         "reflect-metadata":  "0.2.2",
                         "rxjs":  "7.8.2",
                         "typeorm":  "0.3.27",
                         "zod":  "3.25.76"
                     },
    "devDependencies":  {
                            "@nestjs/cli":  "11.0.10",
                            "@nestjs/schematics":  "11.0.9",
                            "@nestjs/testing":  "11.1.6",
                            "@types/cookie-parser":  "1.4.9",
                            "@types/express":  "5.0.3",
                            "@types/jest":  "30.0.0",
                            "@types/node":  "24.10.1",
                            "@types/nodemailer":  "7.0.3",
                            "@types/supertest":  "6.0.3",
                            "@typescript-eslint/eslint-plugin":  "8.46.2",
                            "@typescript-eslint/parser":  "8.46.2",
                            "jest":  "30.2.0",
                            "supertest":  "7.1.4",
                            "ts-jest":  "29.4.5",
                            "ts-node":  "10.9.2",
                            "tsconfig-paths":  "4.2.0",
                            "tsx":  "4.20.6",
                            "typescript":  "5.9.3"
                        }
}