# Dependencias e segredos

# Copie para `.env` e ajuste. NUNCA versione o arquivo `.env` preenchido.
# Este arquivo nao contem segredos e nao deve ser alterado para inclui-los.

# --- Aplicacao ---------------------------------------------------------
NODE_ENV=development
PORT=3000

# Origem publica do frontend. O frontend e a API compartilham esta origem para
# reduzir a configuracao entre dominios; a autenticacao usa o proprio dominio.
PUBLIC_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000

# --- Sessao (item 12) --------------------------------------------------
# Segredo do cookie de sessao. Gere um valor aleatorio de 32 bytes ou mais.
# OBRIGATORIO trocar em qualquer ambiente que nao seja local.
SESSION_SECRET=troque-este-valor-em-qualquer-ambiente-nao-local

# TTL da sessao no Redis. 20 minutos de inatividade e oito horas de duracao
# absoluta sao parametros iniciais PROPOSTOS para servidores; ajustar na
# homologacao.
SESSION_IDLE_TTL_SECONDS=1200
SESSION_ABSOLUTE_TTL_SECONDS=28800

# Nome do cookie. O prefixo `__Host-` exige Secure, path=/ e ausencia de Domain.
SESSION_COOKIE_NAME=__Host-session
# Em desenvolvimento local o Secure impede o cookie de viajar por http. Manter
# false APENAS no ambiente local; producao exige true e HTTPS.
SESSION_COOKIE_SECURE=false

# --- Banco de dados (item 11) ------------------------------------------
# `app` roda com synchronize:false, sem superusuario e sem ALTER. As migracoes
# usam a conta `migrator`, separada.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sertania
POSTGRES_USER=sertania_app
POSTGRES_PASSWORD=app-local-apenas
POSTGRES_MIGRATOR_USER=sertania_migrator
POSTGRES_MIGRATOR_PASSWORD=migrator-local-apenas

# --- Redis (item 12 e 18) ----------------------------------------------
# Sessoes e fila tem instancias ou politicas de memoria SEPARADAS: um job nao
# pode se perder por uma politica de eviction de cache.
# A senha entra na URL porque e assim que o ioredis autentica; os valores
# correspondem aos usados no docker-compose.
REDIS_SESSION_URL=redis://:redis-sessao-local@localhost:6379/0
REDIS_QUEUE_URL=redis://:redis-fila-local@localhost:6380/1

# --- Armazenamento de arquivos (item 13) -------------------------------
# Buckets sem leitura publica. Este e o emulador S3 de desenvolvimento.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=sertania-quarantine
S3_BUCKET_DOCUMENTS=sertania-documents
S3_ACCESS_KEY=sertania-local
S3_SECRET_KEY=sertania-local-secret
S3_FORCE_PATH_STYLE=true

# --- Inspecao de arquivos ----------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Limites do worker de inspecao. Falha ou indisponibilidade mantem o arquivo
# bloqueado; resultado limpo nao prova que o arquivo e inofensivo.
CLAMAV_TIMEOUT_MS=30000

# --- Keycloak (item 12) -------------------------------------------------
# Dois realms: cidadaos e servidores. O institucional tem autocadastro
# desligado e MFA obrigatorio.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM_CITIZENS=sertania-ciudadanos
KEYCLOAK_REALM_SERVERS=sertania-servidores
KEYCLOAK_CLIENT_ID=sertania-api
KEYCLOAK_CLIENT_SECRET=troque-este-client-secret
# Client confidencial usa Authorization Code com PKCE S256. Os fluxos implicit
# e password/direct access grants ficam DESABILITADOS no realm.
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# --- E-mail (item 8) ---------------------------------------------------
# No MVP a entrega e no aplicativo e por e-mail. Mensagens externas sao
# genericas: sem CPF, RG, diagnostico ou documento.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_NAME=Prefeitura de Sertania
SMTP_FROM_ADDRESS=nao-responda@sertania.local

# --- Catalogo demonstrativo (item 8) ------------------------------------
# Prazos simulados sao identificados como tal. Em producao, um servico so
# apresenta compromisso quando a politica foi validada e publicada.
DEMO_SLA_SIMULATED=true
MUNICIPAL_TIMEZONE=America/Recife

# --- Criptografia de campos restritos (item 13) -------------------------
# Envelope encryption. A chave e de dados, nao de master key: o master fica no
# KMS. Guardar versao da chave, nonce e tag; nunca reutilizar nonce.
# Troque em qualquer ambiente nao local. As chaves de producao NAO ficam no .env.
DATA_ENCRYPTION_KEY_VERSION=1
# --- Log e telemetria (item 13) -----------------------------------------
# Nunca registrar corpo de requisicao, nome de arquivo pessoal, dado clinico,
# token ou URL de arquivo.
LOG_LEVEL=info
OTEL_ENABLED=false
